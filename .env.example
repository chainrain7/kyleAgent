# kyleAgent 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
KYLE_HOST=127.0.0.1
KYLE_PORT=7437

# ── Logging ───────────────────────────────────────────────────
KYLE_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
KYLE_LOG_FILE=~/.kyle/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
KYLE_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# KYLE_CONFIG=~/.kyle/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# KYLE_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# KYLE_MAX_STEPS=20

# ── LLM 多后端（改造 C）──────────────────────────────────────
# llm.provider = "openai" 时使用以下配置（Anthropic 兼容端点仍用上面的 ANTHROPIC_*）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1   # 任意 OpenAI 兼容端点
# KYLE_LLM_PROVIDER=openai

# ── 模型路由（改造 A）────────────────────────────────────────
# KYLE_LLM_ROUTER 配置项见 config.toml 的 [llm] 段；环境变量：
# KYLE_LLM_PLANNING_MODEL=deepseek-v4-pro
# KYLE_LLM_EXECUTION_MODEL=deepseek-flash

# ── web_search JSON 后端（改造 D，不配置则用免 key 的 DuckDuckGo）──
# KYLE_SEARCH_API_KEY=
# KYLE_SEARCH_ENDPOINT=
